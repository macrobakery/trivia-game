# ── AI App Builder Challenge — Environment Variables ──────────────
# Copy this file to .env and fill in your values.
# Never commit your actual .env file to version control.

# Anthropic API key — get one at https://console.anthropic.com
# Without this key the game still works; AI hints use a static fallback.
ANTHROPIC_API_KEY=sk-ant-your-key-here

# Admin panel password — protects /admin and destructive API routes
ADMIN_PASSWORD=changeme

# Turso (libSQL) database — production persistence
# Without these vars the server falls back to local SQLite (dev) or
# /tmp/database.db on Vercel (ephemeral — data lost between cold starts).
TURSO_DATABASE_URL=libsql://your-db.turso.io
TURSO_AUTH_TOKEN=your-turso-token

# Web Push (PWA notifications) — generate via: npx web-push generate-vapid-keys
# Both vars must be set or push notifications are silently disabled.
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_CONTACT_EMAIL=mailto:you@example.com
